# generated by build.py — regenerable, not tracked. the built .drawio.svg is copied
# to <Lang>/Graph/, not kept here.
roadmap/*.drawio
roadmap/*.drawio.svg
# local render helpers
roadmap/*.png
roadmap/*.html
# bootstrap re-key provenance (regenerable by bootstrap/remap.py; nothing live reads it)
roadmap/*.remap.tsv
# python bytecode (extract.py imported by remap.py)
__pycache__/
# local virtualenv (setup.py --venv creates it here)
.venv/
