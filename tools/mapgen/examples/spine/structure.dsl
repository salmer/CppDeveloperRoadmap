# Spine insertion: a fixed central trunk at hub-x with a left-of-gate section
# header, and the cluster packed to the RIGHT. hubx/gate are the same for every
# language here -> left of gate stays put, right of gate (x >= gate) reflows.
#   spine hubx=<x> gate=<x> header=<id>
spine hubx=460 gate=420 header=hardskills

[langsyntax] grade=junior
  [stl] grade=junior
    [iostream]       grade=junior
    [datetime]       grade=junior
    [containers]     grade=junior
    [iterators]      grade=junior
    [algorithms]     grade=junior
    [multithreading] grade=middle
  [templates] grade=junior
  [standards] grade=junior
[langtools] grade=junior
  [debugger]     grade=junior
  [buildsystems] grade=junior
