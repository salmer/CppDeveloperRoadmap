# Language-neutral structure. Indentation = hierarchy (2 spaces per level).
# [id] holds a stable key; text lives in <lang>.tsv keyed by that id.
# grade = colour class (junior/middle/senior/optional). Order = source order.

[stdlib] grade=junior
  [iostream]       grade=junior
  [datetime]       grade=junior
  [containers]     grade=junior
  [iterators]      grade=junior
  [algorithms]     grade=junior
  [multithreading] grade=middle
